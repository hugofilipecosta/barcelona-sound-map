# Copy this file to .env and fill in whichever sources you have.
# server/env.mjs loads .env automatically for the API and the jobs in server/jobs/.
# Nothing here is required to run the app locally — Barcelona Open Data and
# OpenStreetMap work with no keys at all, and everything else degrades to
# curated/seed data when a variable is missing.

# --- Concert providers (all optional) ---

# Eventbrite API — https://www.eventbrite.com/platform/api
EVENTBRITE_TOKEN=

# DICE partner GraphQL access (requires approved partner/data-partner status)
DICE_PARTNER_TOKEN=

# FNAC Spectacles / France Billet affiliate XML feed URL (via Awin)
FNAC_FEED_URL=

# Ticketline feed or partner export URL
TICKETLINE_FEED_URL=

# Ticketmaster Discovery API — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Bandsintown artist-events API
BANDSINTOWN_APP_ID=
# Comma-separated list of artist names to track
BANDSINTOWN_ARTISTS=

# --- Barcelona Open Data (no key required; overrides only if you need them) ---

BARCELONA_OPEN_DATA_AGENDA_URL=
BARCELONA_OPEN_DATA_AGENDA_RESOURCE_ID=
BARCELONA_OPEN_DATA_AGENDA_DATASTORE_URL=

# --- OpenStreetMap Overpass (no key required; override only for a different mirror) ---

OVERPASS_API_URL=

# --- Local concert API server (server/concert-api.mjs) ---

# Port the local API listens on. Defaults to 8787.
CONCERT_API_PORT=

# How long a fetched payload is cached before it's considered stale, in ms. Defaults to 300000 (5 minutes).
CONCERT_CACHE_TTL_MS=

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the local dev origins and the Netlify domains in server/concert-api.mjs.
CONCERT_API_ALLOWED_ORIGINS=

# Basic per-client rate limit (requests per minute). Defaults to 60.
CONCERT_API_REQUESTS_PER_MINUTE=

# Set to 1 to include provider status/debug info in API responses. Leave unset in production.
CONCERT_API_EXPOSE_PROVIDER_STATUS=

# --- Client (Vite) ---

# Overrides where the frontend fetches /api/concerts from. Only needed if you're
# not using the built-in Vite dev proxy or the Netlify redirect (e.g. pointing
# the local frontend at a deployed API). Must be prefixed VITE_ to reach the client.
VITE_CONCERT_API_URL=

# --- Catalog jobs (server/jobs/refresh-catalog.mjs, watch-catalog.mjs, rank-catalog.mjs) ---

# Concert API URL the refresh job pulls from (server-side, not the VITE_ one above).
CONCERT_API_URL=

# Minutes between refreshes for watch:catalog. Defaults to 180.
REFRESH_INTERVAL_MINUTES=

# OpenAI API key for rank:catalog's model-based ranking. Falls back to local
# transparent scoring when unset.
OPENAI_API_KEY=
# Defaults to gpt-4.1-mini.
OPENAI_MODEL=
